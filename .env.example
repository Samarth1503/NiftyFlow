POSTGRES_SERVER=localhost
POSTGRES_USER=nifty_user
POSTGRES_PASSWORD=nifty_password
POSTGRES_DB=niftyflow
POSTGRES_PORT=5432

# Background Market Data Scheduling
STOCK_FULL_UPDATE_TIME=21:00
STOCK_FULL_UPDATE_TIMEZONE=UTC
STOCK_ACTIVE_UPDATE_INTERVAL_MINUTES=15

# Rate Limiting & Throttling
YFINANCE_BATCH_SIZE=50
YFINANCE_REQUEST_DELAY_SECONDS=1.0
